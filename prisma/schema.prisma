// Prisma schema for Erfolg medical equipment site.
// Entities: catalog (Category/Brand/Product + images/specs/files), requests
// (Quote/Service/Contact), CMS (Page/BlogPost), auth (AdminUser + AuditLog),
// Setting (key/value JSON), MediaAsset.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────── Catalog ───────────────────────

enum ProductKind {
  EQUIPMENT
  CONSUMABLE
  SPARE_PART
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryToCategory")
  products    Product[]
  sort        Int        @default(0)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  logo      String?
  country   String?
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("brands")
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  sku            String?        @unique
  model          String?
  brandId        String?
  brand          Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDesc      String?        @db.Text
  fullDesc       String?        @db.Text
  kind           ProductKind    @default(EQUIPMENT)
  status         ProductStatus  @default(DRAFT)
  priceOnRequest Boolean        @default(true)
  // Состояние: true = бывшее в употреблении (Б/У)
  isUsed         Boolean        @default(false)
  // Регулятор медизделий (Росздравнадзор)
  regNumber      String?
  regDate        DateTime?
  regUrl         String?
  // SEO
  seoTitle       String?
  seoDesc        String?
  // Order
  sort           Int            @default(0)
  // Связи
  images         ProductImage[]
  specs          ProductSpec[]
  files          ProductFile[]
  quoteRequests  QuoteRequest[]
  // Audit
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([kind])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  sort      Int     @default(0)

  @@index([productId])
  @@map("product_specs")
}

model ProductFile {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  label     String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_files")
}

// ─────────────────────── Requests ───────────────────────

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

model QuoteRequest {
  id           String        @id @default(cuid())
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  // contact
  name         String
  // Телефон необязателен: обязательным сделан email — КП уходит письмом.
  phone        String?
  email        String
  organization String?
  inn          String?
  message      String?       @db.Text
  // Вложения: [{ url, name, size }]. Сайт приглашает прислать ТЗ,
  // спецификацию конкурса или фото шильда — файлы едут сюда.
  attachments  Json?
  // 152-ФЗ
  consent      Boolean
  // tracking
  status       RequestStatus @default(NEW)
  source       String?
  ip           String?
  userAgent    String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([productId])
  @@map("quote_requests")
}

model ServiceRequest {
  id            String        @id @default(cuid())
  // contact
  name          String
  phone         String?
  email         String
  organization  String?
  // equipment
  equipmentName String
  manufacturer  String?
  modelName     String?
  serial        String?
  problem       String        @db.Text
  // Вложения: [{ url, name, size }] — обычно фото шильда или дисплея с ошибкой.
  attachments   Json?
  // 152-ФЗ
  consent       Boolean
  status        RequestStatus @default(NEW)
  ip            String?
  userAgent     String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@map("service_requests")
}

model ContactRequest {
  id          String        @id @default(cuid())
  name        String
  phone       String?
  email       String
  message     String        @db.Text
  attachments Json?
  consent     Boolean
  status      RequestStatus @default(NEW)
  ip          String?
  userAgent   String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("contact_requests")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/**
 * Отзыв клиники. Публикуется только после модерации: брендбук запрещает
 * непроверяемую социальную доказательность, поэтому «сначала опубликовать,
 * потом проверить» здесь не подходит.
 *
 * consent — отметка согласия на публикацию отзыва и персональных данных
 * (текст на /review-consent). Без неё форма не отправляется.
 */
model Review {
  id           String       @id @default(cuid())
  authorName   String
  city         String?
  organization String?
  // Публиковать ли название организации: согласие на публикацию имени
  // и согласие на публикацию работодателя — разные вещи.
  showOrganization Boolean  @default(false)
  text         String       @db.Text
  attachments  Json?
  rating       Int?
  consent      Boolean
  status       ReviewStatus @default(PENDING)
  publishedAt  DateTime?
  moderatorNote String?     @db.Text
  contactEmail String?
  contactPhone String?
  ip           String?
  userAgent    String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, publishedAt])
  @@map("reviews")
}

// ─────────────────────── CMS ───────────────────────

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  seoTitle    String?
  seoDesc     String?
  isPublished Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  content     String    @db.Text
  coverUrl    String?
  authorName  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

// ─────────────────────── Auth ───────────────────────

enum AdminRole {
  OWNER
  EDITOR
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String
  role         AdminRole       @default(EDITOR)
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

model AdminAuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?    @db.Text
  createdAt DateTime   @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ─────────────────── Settings & Media ──────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  size      Int?
  mime      String?
  width     Int?
  height    Int?
  origin    String?
  createdAt DateTime @default(now())

  @@index([origin])
  @@map("media_assets")
}
