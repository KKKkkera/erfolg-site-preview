# Пример боевого окружения. На сервере лежит как /etc/erfolg/erfolg.env
# (systemd читает его через EnvironmentFile), локально — как .env.

# --- База данных ---------------------------------------------------------
# Managed PostgreSQL в Selectel. sslmode=verify-full и корневой сертификат
# Selectel: без проверки сертификата соединение можно подменить, а в базе
# лежат персональные данные из заявок.
DATABASE_URL=postgresql://user:password@host.selectel.ru:5432/erfolg?sslmode=verify-full&sslrootcert=/etc/ssl/certs/selectel-root.crt

# --- Приложение ----------------------------------------------------------
# Полный адрес сайта без завершающего слэша. Идёт в canonical, og:image,
# sitemap и schema.org, поэтому обязателен и обязательно https на бою.
NEXT_PUBLIC_SITE_URL=https://erfolgmt.ru
NEXTAUTH_URL=https://erfolgmt.ru
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Порт, который слушает Node за nginx. Совпадает с proxy_pass в nginx.conf.
PORT=3000
HOSTNAME=127.0.0.1

# --- Режимы --------------------------------------------------------------
# false — сайт открыт роботам и формы работают.
NEXT_PUBLIC_SEO_BLOCK_INDEX=false
NEXT_PUBLIC_FORMS_DISABLED=false

# true только за nginx, который перезаписывает X-Forwarded-For (см. deploy/nginx.conf).
TRUST_PROXY=true

# --- Хранилище Selectel S3 ----------------------------------------------
# Бакет остаётся закрытым: в нём вместе с картинками лежат вложения заявок.
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=erfolg-media
S3_PUBLIC_URL=

# --- Почта ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=

# --- Индексация ----------------------------------------------------------
# IndexNow: ключ + файл public/<ключ>.txt с этим же ключом внутри.
INDEXNOW_KEY=

# --- Первичный админ (только для npm run db:seed) ------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
